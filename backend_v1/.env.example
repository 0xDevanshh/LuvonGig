# ---------------------------------------------------------------------------
# LuvonGig API — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (Neon) -------------------------------------------------------
# Use the POOLED connection string ("-pooler" in the host) for the app.
# Neon requires TLS; keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/luvongig?sslmode=require

# Direct (non-pooled) URL. Some migration tools need a session-mode connection.
# Optional — falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=

# --- Auth ------------------------------------------------------------------
# MUST match the frontend's JWT_SECRET during the proxy phase, otherwise
# sessions issued by Next.js will not verify here (and vice versa).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=sid
# Leave blank for localhost; set to e.g. .luvongig.com in production.
COOKIE_DOMAIN=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000
