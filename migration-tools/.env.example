# IC mainnet. Override only to point at a local replica.
IC_HOST=https://icp0.io

# Canister IDs — from ../backend/canister_ids.json (the `ic` entries).
USER_CANISTER_ID=2wchw-3aaaa-aaaam-ae3ua-cai
MARKETPLACE_CANISTER_ID=ewisl-riaaa-aaaai-atmga-cai
JOB_MARKETPLACE_CANISTER_ID=dckox-biaaa-aaaai-auyua-cai
HACKQUEST_CANISTER_ID=wcpi4-lyaaa-aaaai-atqaq-cai

# Read by `npm run export:escrow` only. Not part of `npm run export`: the
# escrow canister holds money rather than records, so what it still contains is
# a question to ask deliberately before Phase 8 deletes it.
ESCROW_CANISTER_ID=eeofs-5yaaa-aaaai-atmfa-cai

# Target Postgres for the import step. Point at a Neon PREVIEW branch first —
# never rehearse against the branch serving production.
DATABASE_URL=

# Currency assigned to imported prices. Amounts are NOT converted from ICP:
# rows are flagged price_needs_review for the owner to confirm.
IMPORT_CURRENCY=USD
